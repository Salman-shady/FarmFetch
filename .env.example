# Environment variables template for FarmFetch / Digital Platform
# Copy this file to .env for local testing or configure these in your deployment dashboard (Render / Railway)

# MongoDB Connection String (e.g. from MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=farm2table

# Flask Secret Key (generate a random 64-char string for production)
SECRET_KEY=replace_with_a_secure_random_key_64_chars

# Port (Cloud providers like Render / Railway set $PORT automatically)
PORT=5000
